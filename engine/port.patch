+// Browser port, widescreen. The page reports the shape of the area it can show the game in; 0 keeps every
+// screen at the 4:3 menu size, as in the retail game.
+static long menu_screen_wid, menu_screen_hgt;
+static int display_aspect_wid, display_aspect_hgt;
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+extern "C" EMSCRIPTEN_KEEPALIVE void aoe_set_display_aspect(int wid, int hgt) {
+    display_aspect_wid = wid;
+    display_aspect_hgt = hgt;
+}
+#endif
+
+void RGE_Base_Game::set_menu_screen_size(long wid, long hgt) {
+    menu_screen_wid = wid;
+    menu_screen_hgt = hgt;
+}
+
+long RGE_Base_Game::menu_screen_width() {
+    return menu_screen_wid;
+}
+
+void RGE_Base_Game::game_screen_size(long* wid, long* hgt) {
+    *wid = menu_screen_wid;
+    *hgt = menu_screen_hgt;
+    // Only the 4:3 sizes have a game screen layout that widens (TRIBE_Screen_Game::handle_size), not 1280x1024.
+    if (display_aspect_wid <= 0 || display_aspect_hgt <= 0 || menu_screen_wid * 3 != menu_screen_hgt * 4)
+        return;
+    // Whole multiples of 8 pixels, up to 2.4:1 (21:9 monitors).
+    long wide = (long) ((double) menu_screen_hgt * display_aspect_wid / display_aspect_hgt);
+    if (wide > menu_screen_hgt * 12 / 5)
+        wide = menu_screen_hgt * 12 / 5;
+    wide &= ~7;
+    if (wide >= menu_screen_wid + 16)
+        *wid = wide;
+}
+
+// The game screen is laid out at the menu size when created and widens once shown; every other screen is
+// created and shown at the menu size (their layouts and backgrounds are 4:3 only).
+void RGE_Base_Game::fit_screen(TPanel* screen, int creating) {
+    if (this->draw_area == 0 || this->draw_system == 0 || menu_screen_wid == 0 || screen == 0)
+        return;
+    long wid = menu_screen_wid;
+    long hgt = menu_screen_hgt;
+    if (screen->panelName() != 0 && strcmp(screen->panelName(), "Game Screen") == 0) {
+        if (creating)
+            return;
+        game_screen_size(&wid, &hgt);
+    }
+    if (this->draw_area->Width != wid || this->draw_area->Height != hgt)
+        this->set_screen_size(wid, hgt);
+}
