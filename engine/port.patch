+    long base_hgt = 480;
+    if (wid >= 1024 && hgt >= 768) {
+        base_wid = 1024;
+        base_hgt = 768;
+    } else if (wid >= 800 && hgt >= 600) {
+        base_wid = 800;
+        base_hgt = 600;
+    }
+    return (hgt == base_hgt && wid > base_wid) ? wid - base_wid : 0;
+}
+
+// Widescreen: one strip of the game screen art (frame 0: the top bar, frame 1: the bottom panel) drawn dx wider.
+// Columns left of keep_left stay in place, the art from keep_left on is drawn dx to the right, and the gap
+// between is filled with copies of the art's columns [keep_left, keep_left + period), right to left, so the
+// copies join each other and the shifted art without a seam where the art repeats every period columns.
+static void draw_wide_strip(TShape* pic, TDrawArea* area, long y, int frame, long keep_left, long period, long dx) {
+    // Parts outside the clip rectangle (a child panel redrawing its background) are skipped: an inverted
+    // rectangle does not clip.
+    tagRECT clip = area->ClipRect;
+    tagRECT part = clip;
+    if (part.right > keep_left - 1)
+        part.right = keep_left - 1;
+    if (part.left <= part.right) {
+        area->SetClipRect(&part);
+        pic->shape_draw(area, 0, y, frame, 0, 0);
+    }
+    for (long offset = dx; offset + keep_left + period > keep_left; offset -= period) {
+        part = clip;
+        if (part.left < offset + keep_left)
+            part.left = offset + keep_left;
+        if (offset != dx && part.right > offset + keep_left + period - 1)
+            part.right = offset + keep_left + period - 1;
+        if (part.left < keep_left)
+            part.left = keep_left;
+        if (part.left <= part.right) {
+            area->SetClipRect(&part);
+            pic->shape_draw(area, offset, y, frame, 0, 0);
+        }
+    }
+    area->SetClipRect(&clip);
+}
+
+// The game screen art at any width: the retail drawing at the 4:3 sizes, widened otherwise.
+static void draw_game_screen_art(TShape* pic, TDrawArea* area, long wid, long hgt, int culture) {
+    // Columns of each culture's art (Egyptian, Greek, Babylonian, East Asian, Roman) after which it repeats, or
+    // nearly (top bar, bottom panel), measured from the retail art at each size.
+    static const short periods[3][5][2] = {
+        {{79, 217}, {88, 229}, {89, 202}, {91, 195}, {49, 118}},
+        {{79, 217}, {88, 229}, {89, 202}, {91, 413}, {58, 363}},
+        {{446, 217}, {88, 459}, {89, 202}, {91, 637}, {53, 471}},
+    };
+    int size = 0;
+    long bottom_y = 354;
+    if (wid >= 1024 && hgt >= 768) {
+        size = 2;
+        bottom_y = 642;
+    } else if (wid >= 800 && hgt >= 600) {
+        size = 1;
+        bottom_y = 474;
+    }
+    long dx = game_screen_wide_dx(wid, hgt);
+    if (dx == 0) {
+        pic->shape_draw(area, 0, 0, 0, 0, 0);
+        pic->shape_draw(area, 0, bottom_y, 1, 0, 0);
+        return;
+    }
+    if (culture < 0 || culture >= 5)
+        culture = 0;
+    // The top bar keeps the inventory at the left; the bottom panel keeps the object panel's frame.
+    draw_wide_strip(pic, area, 0, 0, 270, periods[size][culture][0], dx);
+    draw_wide_strip(pic, area, bottom_y, 1, 136, periods[size][culture][1], dx);
+}
